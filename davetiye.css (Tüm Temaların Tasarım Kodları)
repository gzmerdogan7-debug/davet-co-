@import url("https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Inter:wght@300;400;500&family=Cinzel:wght@400;500;600&family=Pinyon+Script&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Gabarito:wght@400;600;700&family=Poppins:wght@300;400;500&family=Marcellus&family=Karla:wght@300;400;500&display=swap");

*, *::before, *::after { box-sizing: border-box; }

:root, [data-tema="editoryal"] {
  --zemin: #f0eee9; --zemin-2: #e4e1da; --metin: #1a1a1a; --metin-soluk: #6e6b63;
  --vurgu: #1c2a4a; --cizgi: #cfcbc2; --kart: #f7f6f3; --golge: rgba(26, 26, 26, 0.1);
  --f-baslik: "Archivo", system-ui, sans-serif; --f-govde: "Inter", system-ui, sans-serif;
  --f-vurgu: "Archivo", sans-serif; --baslik-agirlik: 600; --baslik-aralik: -0.02em;
  --isim-boyut: clamp(2.4rem, 12vw, 3.4rem); --kose: 0px;
}

[data-tema="bordo"] {
  --zemin: #3a1220; --zemin-2: #4d1829; --metin: #f3e7d3; --metin-soluk: #c9a98a;
  --vurgu: #c9a84c; --cizgi: rgba(201, 168, 76, 0.42); --kart: rgba(255, 255, 255, 0.045);
  --golge: rgba(0, 0, 0, 0.5); --f-baslik: "Cinzel", serif; --f-govde: "Cormorant Garamond", serif;
  --f-vurgu: "Pinyon Script", cursive; --baslik-agirlik: 500; --baslik-aralik: 0.06em;
  --isim-boyut: clamp(2rem, 9.5vw, 2.7rem); --kose: 2px;
}

[data-tema="retro"] {
  --zemin: #f5ebd8; --zemin-2: #efdfc4; --metin: #3a2417; --metin-soluk: #8a6448;
  --vurgu: #c4663a; --cizgi: rgba(160, 75, 42, 0.35); --kart: #fbf4e6;
  --golge: rgba(58, 36, 23, 0.16); --f-baslik: "Gabarito", sans-serif; --f-govde: "Poppins", sans-serif;
  --f-vurgu: "Gabarito", sans-serif; --baslik-agirlik: 700; --baslik-aralik: -0.015em;
  --isim-boyut: clamp(2.5rem, 13vw, 3.5rem); --kose: 20px;
}

[data-tema="kemer"] {
  --zemin: #f5f0e8; --zemin-2: #e8dfd1; --metin: #4a382c; --metin-soluk: #9a8571;
  --vurgu: #a47764; --cizgi: rgba(164, 119, 100, 0.36); --kart: #fbf8f3;
  --golge: rgba(74, 56, 44, 0.13); --f-baslik: "Marcellus", serif; --f-govde: "Karla", sans-serif;
  --f-vurgu: "Marcellus", serif; --baslik-agirlik: 400; --baslik-aralik: 0.03em;
  --isim-boyut: clamp(2.3rem, 11vw, 3.1rem); --kose: 0px;
}

html, body { margin: 0; padding: 0; min-height: 100%; }
body {
  background: var(--zemin); color: var(--metin); font-family: var(--f-govde);
  font-weight: 300; line-height: 1.72; overflow-x: hidden;
}
body.kilitli { overflow: hidden; }

/* Kapak */
#kapak {
  position: fixed; inset: 0; z-index: 50; display: flex; align-items: center;
  justify-content: center; padding: 24px; background: var(--zemin);
  transition: opacity 1.1s ease, transform 1.1s ease;
}
#kapak.acik { opacity: 0; transform: scale(1.05); pointer-events: none; }
.kapak-cerceve {
  position: relative; width: 100%; max-width: 360px; padding: 52px 28px 42px;
  text-align: center; background: var(--kart); border-radius: var(--kose);
}
[data-tema="kemer"] .kapak-cerceve {
  border-radius: 170px 170px 0 0; border: 1px solid var(--cizgi);
  box-shadow: 0 22px 56px -30px var(--golge);
}
[data-tema="bordo"] .kapak-cerceve {
  border: 1px solid var(--vurgu); background: rgba(0,0,0,0.2);
}
.ust-yazi {
  font-size: 0.63rem; letter-spacing: 0.42em; text-transform: uppercase;
  color: var(--vurgu); margin: 0 0 20px;
}
.isimler {
  font-family: var(--f-baslik); font-weight: var(--baslik-agirlik);
  font-size: var(--isim-boyut); line-height: 1.1; margin: 0;
}
.isimler .ve {
  display: block; font-family: var(--f-vurgu); font-size: 0.45em;
  color: var(--vurgu); margin: 6px 0;
}
.kapak-misafir { margin: 24px 0 0; font-size: 0.88rem; color: var(--metin-soluk); }
.kapak-misafir strong {
  display: block; font-family: var(--f-baslik); font-size: 1.35rem;
  color: var(--metin); margin-top: 3px;
}
#acBtn {
  margin-top: 32px; padding: 15px 30px; border: 1px solid var(--vurgu);
  border-radius: 999px; background: transparent; color: var(--vurgu);
  font-family: inherit; font-size: 0.7rem; letter-spacing: 0.2em;
  text-transform: uppercase; cursor: pointer; transition: all 0.3s;
}
#acBtn:hover { background: var(--vurgu); color: var(--zemin); }

/* Bölümler */
main { position: relative; z-index: 1; }
.bolum { padding: 60px 24px; text-align: center; max-width: 500px; margin: 0 auto; }
.bolum.serit { max-width: none; background: var(--zemin-2); }
.bolum > * { max-width: 500px; margin-left: auto; margin-right: auto; }
.etiket {
  font-size: 0.6rem; letter-spacing: 0.4em; text-transform: uppercase;
  color: var(--vurgu); margin: 0 0 16px;
}
.bolum h2 {
  font-family: var(--f-baslik); font-weight: var(--baslik-agirlik);
  font-size: clamp(1.7rem, 7vw, 2.2rem); margin: 0 0 14px;
}
.bolum p { margin: 0 0 12px; color: var(--metin-soluk); font-size: 0.95rem; }

/* Geri Sayım */
.sayac { display: flex; justify-content: center; gap: 8px; margin-top: 6px; }
.sayac div {
  flex: 1; max-width: 80px; padding: 14px 4px; border: 1px solid var(--cizgi);
  border-radius: var(--kose); background: var(--kart);
}
.sayac b {
  display: block; font-family: var(--f-baslik); font-size: 1.8rem;
  line-height: 1; color: var(--metin);
}
.sayac span {
  display: block; margin-top: 6px; font-size: 0.55rem;
  letter-spacing: 0.16em; text-transform: uppercase; color: var(--metin-soluk);
}

/* Çoklu Etkinlik Sekmeleri & Kartları */
.etkinlik-sekmeler {
  display: inline-flex; gap: 6px; padding: 5px; background: var(--kart);
  border: 1px solid var(--cizgi); border-radius: 999px; margin-bottom: 24px;
}
.etkinlik-sekmeler .sekme {
  padding: 10px 18px; border: 0; border-radius: 999px; background: transparent;
  color: var(--metin-soluk); font-family: inherit; font-size: 0.72rem;
  text-transform: uppercase; cursor: pointer; transition: all 0.25s;
}
.etkinlik-sekmeler .sekme.secili { background: var(--vurgu); color: var(--zemin); }
.etkinlik-kart {
  background: var(--kart); border: 1px solid var(--cizgi);
  border-radius: var(--kose); padding: 30px 20px;
}
.etkinlik-tur {
  display: inline-block; font-size: 0.65rem; letter-spacing: 0.25em;
  text-transform: uppercase; color: var(--vurgu); margin-bottom: 6px;
}
.tarih-saat-vurgu { font-family: var(--f-baslik); font-size: 1.15rem; margin-bottom: 10px; }

/* Butonlar */
.dugme {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  margin: 8px 4px 0; padding: 13px 22px; border: 1px solid var(--vurgu);
  border-radius: 999px; background: transparent; color: var(--vurgu);
  font-family: inherit; font-size: 0.68rem; letter-spacing: 0.16em;
  text-transform: uppercase; text-decoration: none; cursor: pointer; transition: all 0.3s;
}
.dugme:hover { background: var(--vurgu); color: var(--zemin); }
.dugme.dolu { background: var(--vurgu); color: var(--zemin); }
.dugme svg { width: 15px; height: 15px; }

/* Rozetler */
.rozet-izgara { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; margin-top: 20px; text-align: left; }
.bilgi-rozet { background: var(--kart); border: 1px solid var(--cizgi); border-radius: var(--kose); padding: 18px; }
.bilgi-rozet .rozet-ikon { font-size: 1.3rem; display: block; margin-bottom: 6px; }
.bilgi-rozet b { display: block; font-family: var(--f-baslik); font-size: 1.05rem; margin-bottom: 4px; }
.bilgi-rozet p { font-size: 0.8rem; line-height: 1.5; color: var(--metin-soluk); margin: 0; }

/* IBAN */
.iban-kart { background: var(--kart); border: 1px dashed var(--vurgu); border-radius: var(--kose); padding: 24px 18px; max-width: 380px; margin: 0 auto; }
.iban-sahip { display: block; font-weight: 500; font-size: 0.95rem; }
.iban-banka { display: block; font-size: 0.75rem; color: var(--metin-soluk); margin: 2px 0 10px; }
.iban-no { display: block; font-family: monospace; font-size: 0.88rem; padding: 8px; background: rgba(0,0,0,0.04); border-radius: 6px; color: var(--vurgu); margin-bottom: 12px; word-break: break-all; }

/* LCV */
.lcv-secim { display: flex; gap: 10px; justify-content: center; margin: 20px 0 16px; flex-wrap: wrap; }
.lcv-secim button {
  flex: 1 1 130px; max-width: 180px; padding: 15px 12px; border: 1px solid var(--cizgi);
  border-radius: var(--kose); background: var(--kart); color: var(--metin);
  font-family: inherit; font-size: 0.85rem; cursor: pointer; transition: all 0.25s;
}
.lcv-secim button.secili { border-color: var(--vurgu); background: var(--vurgu); color: var(--zemin); }
.lcv-alan { display: none; }
.lcv-alan.gorunur { display: block; }
.lcv-alan label { display: block; font-size: 0.62rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--metin-soluk); margin: 14px 0 6px; text-align: left; }
.lcv-alan input, .lcv-alan textarea, .lcv-alan select {
  width: 100%; padding: 12px 14px; border: 1px solid var(--cizgi);
  border-radius: var(--kose); background: var(--kart); color: var(--metin);
  font-family: inherit; font-size: 0.92rem;
}
.lcv-alan textarea { min-height: 80px; resize: vertical; }
#lcvSonuc { margin-top: 16px; font-size: 0.9rem; color: var(--vurgu); min-height: 1.4em; }

/* Yüzen Kontroller */
#muzikBtn {
  position: fixed; right: 16px; bottom: 16px; z-index: 40; width: 44px; height: 44px;
  display: none; align-items: center; justify-content: center; border: 1px solid var(--cizgi);
  border-radius: 50%; background: var(--kart); color: var(--vurgu); cursor: pointer;
}
#muzikBtn.gorunur { display: flex; }
#muzikBtn svg { width: 18px; height: 18px; }

/* Karekod & Alt Bilgi */
.qr-kutu { display: inline-block; padding: 12px; margin-top: 10px; border-radius: var(--kose); background: #fff; line-height: 0; box-shadow: 0 10px 30px -15px var(--golge); }
.qr-kutu svg { width: 150px; height: 150px; }
footer { padding: 40px 20px 60px; text-align: center; border-top: 1px solid var(--cizgi); }
footer p { margin: 0; font-size: 0.62rem; letter-spacing: 0.25em; text-transform: uppercase; color: var(--metin-soluk); }

.gizli { opacity: 0; transform: translateY(24px); transition: opacity 0.8s ease, transform 0.8s ease; }
.gizli.gorundu { opacity: 1; transform: none; }
